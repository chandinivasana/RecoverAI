# Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://postgres:recoveraipassword@localhost:5432/recoverai

# Redis Connection (Redis or In-Memory fallback)
REDIS_URL=redis://localhost:6379/0

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Startup behavior
# SEED_ON_STARTUP: seed the 1,000-transaction synthetic dataset at boot (default: true)
# DEMO_WARM_START: batch-process ~150 dev payments at boot so dashboards are non-zero (default: false)
SEED_ON_STARTUP=true
DEMO_WARM_START=false

# Payment intelligence provider (see backend/app/core/vulcan_adapter.py)
VULCAN_ENABLED=true

# LLM reasoning layer (see backend/app/core/llm_reasoner.py)
# The LLM proposes and explains — it NEVER gates execution. Any failure falls
# back to deterministic reasoning (audited as LLM_FALLBACK). CI runs with it off.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_TIMEOUT_SECONDS=6
LLM_MAX_TOKENS=512
